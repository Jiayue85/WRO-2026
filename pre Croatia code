  Serial.begin(115200);

  pinMode(BUTTON_PIN, INPUT_PULLUP);

  leftMotor.setEnablePin(LEFT_ENABLE_PIN);
  rightMotor.setEnablePin(RIGHT_ENABLE_PIN);

  // Third argument inverts the active-low enable pins used by common drivers.
  leftMotor.setPinsInverted(false, false, true);
  rightMotor.setPinsInverted(false, false, true);

  leftMotor.setMinPulseWidth(DRIVER_MIN_PULSE_US);
  rightMotor.setMinPulseWidth(DRIVER_MIN_PULSE_US);

  leftMotor.enableOutputs();
  rightMotor.enableOutputs();

  leftMotor.setCurrentPosition(0);
  rightMotor.setCurrentPosition(0);

  // HC-SR04
  pinMode(HC_SR04_TRIGGER_PIN, OUTPUT);
  pinMode(HC_SR04_ECHO_PIN, INPUT);
  digitalWrite(HC_SR04_TRIGGER_PIN, LOW);
  resetUltrasonic();

  backServo.attach(SERVO_PIN);
  backServo.write(SERVO_START_ANGLE);
  delay(SERVO_STARTUP_MS);  // Setup-only delay; motors are not running yet.

  lastRawButtonState = digitalRead(BUTTON_PIN);
  stableButtonState = lastRawButtonState;
  buttonLastChangedMs = millis();

  debugText(F("Ready. Press the button to start."));
}

void loop() {
  updateButton();
  updateCurrentCommand();
}
