// ESP32 packet format: TYPE|two-digit-XOR-hex|payload\n .
// TYPE D is a debug line, M is a distance in millimetres, and S is the
// currently running program step (for example: "12|MOVE_CMD(-980,700,100)").
uint8_t xorChecksum(const char *s) { uint8_t x = 0; while (*s) x ^= (uint8_t)*s++; return x; }
void sendPacket(char type, const char *payload) {
  char cs[3]; snprintf(cs, sizeof(cs), "%02X", xorChecksum(payload));
  Serial1.print(type); Serial1.print('|'); Serial1.print(cs); Serial1.print('|');
  Serial1.print(payload); Serial1.print('\n');
}
void debugLine(const char *s) { if (DEBUG_ENABLED) { Serial.println(s); sendPacket('D', s); } }
void dashboardDistance(uint16_t mm) { char s[8]; ultoa(mm, s, 10); sendPacket('M', s); }
void dashboardStep(const char *step) { sendPacket('S', step); }

enum CommandType : uint8_t { CMD_MOVE_MM, CMD_MOVE_UNTIL_SENSOR, CMD_TURN_DEG,
  CMD_SERVO, CMD_WAIT, CMD_CHECK_DISTANCE, CMD_END };
struct Command { CommandType type; float value; uint16_t maxSpeed, acceleration, settleAfterMs; };
#define MOVE_CMD(mm, speedValue, accelValue) { CMD_MOVE_MM, (mm), (speedValue), (accelValue), MOVE_SETTLE_MS }
#define SENSOR_MOVE_CMD(distanceValue, speedValue, accelValue) { CMD_MOVE_UNTIL_SENSOR, (distanceValue), (speedValue), (accelValue), SENSOR_SETTLE_MS }
#define TURN_CMD(degreesValue) { CMD_TURN_DEG, (degreesValue), 500, 100, TURN_SETTLE_MS }
#define SERVO_CMD(angleValue, waitValue) { CMD_SERVO, (angleValue), 0, 0, (waitValue) }
// WAIT_CMD is seconds: WAIT_CMD(0.5) waits 500 ms without delay().
#define WAIT_CMD(secondsValue) { CMD_WAIT, (secondsValue), 0, 0, 0 }
#define CHECK_DISTANCE_CMD { CMD_CHECK_DISTANCE, 0, 0, 0, 0 }
#define END_CMD { CMD_END, 0, 0, 0, 0 }

