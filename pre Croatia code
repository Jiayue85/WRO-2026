// with a 200-step direct drive motor). Both drivers must match this setting.
constexpr float EFFECTIVE_STEPS_PER_WHEEL_REV = FULL_STEPS_PER_MOTOR_REV
  * MICROSTEP_DIVISOR * MOTOR_REVS_PER_WHEEL_REV;
