// Mechanical calibration
// -----------------------------------------------------------------------------
constexpr float TRACK_WIDTH_MM       = 138.5f;  // wheel contact-centre to centre
constexpr float WHEEL_DIAMETER_MM    = 88.0f;
constexpr float WHEEL_CIRCUMFERENCE_MM = PI * WHEEL_DIAMETER_MM;

// Number of driver STEP pulses for one complete wheel revolution.
// Example: 200-step motor at 1/16 microstepping and no gearing = 3200.
// Keep this at 200 only if one wheel revolution genuinely takes 200 pulses.
constexpr float EFFECTIVE_STEPS_PER_WHEEL_REV = 200.0f;

// Overall distance calibration.
// Example: command 1000 mm, measure 970 mm -> set to 1000 / 970 = 1.0309.
constexpr float DISTANCE_SCALE = 1.0000f;

// Straight-line trims. Start both at 1.0000.
// If the robot consistently curves right, reduce LEFT_STRAIGHT_TRIM slightly
// or increase RIGHT_STRAIGHT_TRIM slightly. Change only 0.002-0.005 at a time.
constexpr float LEFT_STRAIGHT_TRIM  = 1.0000f;
constexpr float RIGHT_STRAIGHT_TRIM = 0.9927f;

// float LEFT_STRAIGHT_TRIM  = 1.0000f;
// float RIGHT_STRAIGHT_TRIM = 0.9927f;



// Separate turn calibration because left and right turns can differ under load.
// Example: commanded 90 degrees but turns 87 degrees -> 90 / 87 = 1.0345.//

constexpr float LEFT_TURN_SCALE  = 1.027f;
constexpr float RIGHT_TURN_SCALE = 1.027f;

// Optional per-wheel turn trims. Normally leave these at 1.0000.
constexpr float LEFT_WHEEL_TURN_TRIM  = 1.0000f;
constexpr float RIGHT_WHEEL_TURN_TRIM = 1.0000f;

