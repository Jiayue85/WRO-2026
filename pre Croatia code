void debugText(const __FlashStringHelper *message) {
  if (DEBUG_ENABLED) Serial.println(message);
}

void debugCommandStart(const Command &command) {
  // Only called between movements, before a new trajectory is armed.
  if (!DEBUG_ENABLED) return;
  Serial.print(F("Command "));
  Serial.print(commandIndex);
  Serial.print(F(" type "));
  Serial.print((int)command.type);
  Serial.print(F(" value "));
