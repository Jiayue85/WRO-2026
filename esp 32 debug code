/* Combined ESP32 dashboard: original Robot-Debug Wi-Fi access point plus
   Mega packet support: D=debug, S=current step, M=distance. */
#include <WiFi.h>
#include <WebServer.h>

const char *AP_SSID = "Robot-Debug";
const char *AP_PASSWORD = "debug123";
constexpr int MEGA_RX_PIN = 16; // From Mega TX1/18 via 5 V -> 3.3 V level shifter
constexpr int MEGA_TX_PIN = 17; // To Mega RX1/19 (optional)
constexpr unsigned long LINK_BAUD = 115200UL;
HardwareSerial MegaSerial(2);
WebServer server(80);

constexpr uint8_t MAX_LOGS = 80;
constexpr size_t MAX_LINE_LENGTH = 250;
struct LogEntry { uint32_t id, timestamp; String message; };
LogEntry logs[MAX_LOGS];
uint8_t logStart = 0, logCount = 0;
uint32_t nextLogId = 1;
String currentStep = "Waiting for the program to start";
String latestDistance = "--";
char incomingLine[MAX_LINE_LENGTH + 1];
size_t incomingLength = 0;

String timeText(uint32_t ms) { char b[16]; snprintf(b,sizeof(b),"%02lu:%02lu:%02lu",(unsigned long)(ms/3600000UL),(unsigned long)((ms/60000UL)%60),(unsigned long)((ms/1000UL)%60)); return String(b); }
String escapeJson(const String &in) { String out; out.reserve(in.length()+8); for(size_t i=0;i<in.length();++i){char c=in[i]; if(c=='\"')out+="\\\""; else if(c=='\\')out+="\\\\"; else if(c=='\n')out+="\\n"; else if(c=='\r')out+="\\r"; else if((uint8_t)c>=32)out+=c;} return out; }
void addLog(const String &message) { if(!message.length())return; uint8_t pos; if(logCount<MAX_LOGS){pos=(logStart+logCount)%MAX_LOGS;++logCount;}else{pos=logStart;logStart=(logStart+1)%MAX_LOGS;} logs[pos]={nextLogId++,millis(),message}; Serial.print("[MEGA] ");Serial.println(message); }
void clearLogs() { logStart=0;logCount=0; }

uint8_t xorChecksum(const char *s) { uint8_t x=0;while(*s)x^=(uint8_t)*s++;return x; }
bool parseHexByte(const char *s,uint8_t &v) { if(strlen(s)!=2)return false; char *e;long n=strtol(s,&e,16);if(*e||n<0||n>255)return false;v=(uint8_t)n;return true; }
void processMegaLine(char *line) {
  // Plain lines are accepted too, so this works with the old Mega sketch.
  char *first=strchr(line,'|'); if(!first){addLog(String(line));return;} *first++=0;
  char *second=strchr(first,'|'); if(!second){addLog("WARN: incomplete Mega packet ignored");return;} *second++=0;
  uint8_t received;
  if(strlen(line)!=1 || !parseHexByte(first,received) || xorChecksum(second)!=received){addLog("WARN: corrupt Mega packet ignored");return;}
  if(line[0]=='D') addLog(String(second));
  else if(line[0]=='S'){currentStep=second;addLog(String("INFO: Running step ")+currentStep);}
  else if(line[0]=='M'){latestDistance=second;addLog(String("INFO: Distance updated: ")+latestDistance+" mm");}
  else addLog("WARN: unknown Mega packet ignored");
}
void serviceMegaSerial() { while(MegaSerial.available()){char c=(char)MegaSerial.read();if(c=='\r')continue;if(c=='\n'){incomingLine[incomingLength]=0;if(incomingLength)processMegaLine(incomingLine);incomingLength=0;}else if(incomingLength<MAX_LINE_LENGTH)incomingLine[incomingLength++]=c;else{incomingLength=0;addLog("WARN: overlong Mega message ignored");}} }

