void handleHome(){server.send_P(200,"text/html",INDEX_HTML);}
void handleStatus(){String json="{\"step\":\""+escapeJson(currentStep)+"\",\"distance\":\""+escapeJson(latestDistance)+"\",\"logs\":[";for(uint8_t i=0;i<logCount;++i){if(i)json+=',';const LogEntry &e=logs[(logStart+i)%MAX_LOGS];json+="{\"id\":"+String(e.id)+",\"time\":\""+timeText(e.timestamp)+"\",\"message\":\""+escapeJson(e.message)+"\"}";}json+="]}";server.sendHeader("Cache-Control","no-store");server.send(200,"application/json",json);}
void handleClear(){clearLogs();addLog("INFO: Debug log cleared");server.send(200,"application/json","{\"success\":true}");}

void setup(){Serial.begin(115200);MegaSerial.begin(LINK_BAUD,SERIAL_8N1,MEGA_RX_PIN,MEGA_TX_PIN);WiFi.mode(WIFI_AP);if(!WiFi.softAP(AP_SSID,AP_PASSWORD))Serial.println("Failed to start Wi-Fi access point.");server.on("/",HTTP_GET,handleHome);server.on("/api/status",HTTP_GET,handleStatus);server.on("/api/clear",HTTP_POST,handleClear);server.onNotFound([](){server.send(404,"text/plain","Page not found");});server.begin();Serial.println();Serial.println("ESP32 debug dashboard started");Serial.print("Wi-Fi network: ");Serial.println(AP_SSID);Serial.print("Dashboard address: http://");Serial.println(WiFi.softAPIP());addLog("OK: ESP32 dashboard started");addLog("INFO: Waiting for Arduino Mega messages");}
void loop(){serviceMegaSerial();server.handleClient();delay(1);}
